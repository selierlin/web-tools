# 拨测后端环境变量（复制为 .env，不要提交）
# 生产环境的 .env 放在数据目录：/usr/Projects/web-tools-data/boce/.env

# 会话签名密钥，必须修改；一旦更换，所有人需要重新输入口令（数据不丢）
BOCE_SECRET=please-change-me-to-a-random-64-char-string

# 可选邀请码：留空则任何人输入口令即可创建空间；填了则登录时必须一并输入
BOCE_INVITE=

# 数据目录（账号、历史、领取记录），必须在代码同步目录之外
BOCE_DATA_DIR=/usr/Projects/web-tools-data/boce

# 监听端口，默认 8899
PORT=8899
